# Copy this file to .env for local development, and add the same values
# in Netlify under Site settings → Environment variables for deployment.
# NEVER commit your real .env file or share these values publicly.

# --- Supabase (Project Settings → API) ---------------------------------
# Safe to expose in the browser: these are the public URL + anon key.
# RLS policies (see supabase/schema.sql) control what the anon key can do.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- WhatsApp -----------------------------------------------------------
# Country code + number, digits only. No +, spaces or hyphens.
# Example for an Indian number +91 98765 43210:
VITE_WHATSAPP_NUMBER=919876543210
